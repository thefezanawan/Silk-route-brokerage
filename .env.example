# ---- Server ----
NODE_ENV=production
PORT=3000
# Set to 1 when behind a reverse proxy / load balancer (Nginx, Render, Railway, Fly, Heroku...)
TRUST_PROXY=1
# Public site URL
SITE_URL=https://www.silkroutebrokerage.com
# Extra origins allowed to POST to the API (comma separated). Leave empty for same-origin only.
ALLOWED_ORIGINS=

# ---- Quote emails (SMTP) ----
# Gmail example: smtp.gmail.com / 465 / true, with an App Password (Google Account > Security > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-app-password
# Shown as the sender. Use an address on a domain you control, or the SMTP account itself.
MAIL_FROM="Silk Route Website <your-account@gmail.com>"
# Who receives quote requests (comma separated for several people)
MAIL_TO=kwilliams@silkroutebrokerage.com
# Send the customer an automatic "we received your request" email (true/false)
SEND_CONFIRMATION=false

# ---- Storage & limits ----
# Keep a copy of every request in DATA_DIR/quotes.jsonl (true/false)
STORE_QUOTES=true
DATA_DIR=./data
# Quote form: max requests per IP per window
QUOTE_RATE_MAX=5
QUOTE_RATE_WINDOW_MIN=15

# Testing only: accept and store requests without SMTP.
# In production the server refuses to start without SMTP unless this is true.
STORE_ONLY=false
